# Normalize everything to LF in the repo and on checkout so Windows/WSL
# editors can't flip the whole tree to CRLF.
* text=auto eol=lf

# Shell scripts must stay LF: a CRLF shebang fails inside Linux containers.
*.sh text eol=lf

# Binaries
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.jar binary
